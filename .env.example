# Copy this file to ".env" in the repo root and fill in real values.
# ASP.NET Core maps double underscores to nested config:
#   ConnectionStrings__DefaultConnection → ConnectionStrings:DefaultConnection
#   Jwt__Key → Jwt:Key

ConnectionStrings__DefaultConnection=Host=YOUR_NEON_HOST;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=VerifyFull;Channel Binding=Require;
Jwt__Key=replace-with-a-local-key-at-least-32-characters
Gemini__ApiKey=your-gemini-api-key
Gemini__Model=gemini-3.6-flash
