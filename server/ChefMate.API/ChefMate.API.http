@ChefMate.API_HostAddress = http://localhost:5288
@token = 

### Register
POST {{ChefMate.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "supriya@example.com",
  "password": "Password1",
  "displayName": "Supriya",
  "phoneNumber": "+15555550100"
}

### Login
POST {{ChefMate.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "supriya@example.com",
  "password": "Password1"
}

### Get allergies
GET {{ChefMate.API_HostAddress}}/api/allergies
Authorization: Bearer {{token}}

### Get cuisines
GET {{ChefMate.API_HostAddress}}/api/cuisines
Authorization: Bearer {{token}}

### Get profile
GET {{ChefMate.API_HostAddress}}/api/profile
Authorization: Bearer {{token}}

### Update profile
PUT {{ChefMate.API_HostAddress}}/api/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dietaryPreference": "Vegetarian",
  "cookingSkill": "Intermediate",
  "householdSize": 2,
  "allergies": ["Peanuts"],
  "cuisines": ["Indian", "Italian", "Thai"]
}

### List pantry
GET {{ChefMate.API_HostAddress}}/api/pantry
Authorization: Bearer {{token}}

### List pantry categories
GET {{ChefMate.API_HostAddress}}/api/pantry/categories
Authorization: Bearer {{token}}

### Add pantry item
POST {{ChefMate.API_HostAddress}}/api/pantry
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tomato",
  "quantity": 4,
  "unit": "Piece",
  "categoryName": "Produce"
}

### Search pantry
GET {{ChefMate.API_HostAddress}}/api/pantry?search=tom&expiryStatus=ExpiringSoon
Authorization: Bearer {{token}}

### Update pantry quantity
PATCH {{ChefMate.API_HostAddress}}/api/pantry/1/quantity
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 6
}

### Update pantry item
PUT {{ChefMate.API_HostAddress}}/api/pantry/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tomato",
  "quantity": 6,
  "unit": "Piece",
  "categoryName": "Produce",
  "expiryDate": "2026-09-01"
}

### Delete pantry item
DELETE {{ChefMate.API_HostAddress}}/api/pantry/1
Authorization: Bearer {{token}}
