@ChefMate.API_HostAddress = http://localhost:5288
@token = 

### Register
POST {{ChefMate.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "supriya@example.com",
  "password": "Password1",
  "displayName": "Supriya",
  "phoneNumber": "+15555550100"
}

### Login
POST {{ChefMate.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "supriya@example.com",
  "password": "Password1"
}

### Get allergies
GET {{ChefMate.API_HostAddress}}/api/allergies
Authorization: Bearer {{token}}

### Get cuisines
GET {{ChefMate.API_HostAddress}}/api/cuisines
Authorization: Bearer {{token}}

### Get profile
GET {{ChefMate.API_HostAddress}}/api/profile
Authorization: Bearer {{token}}

### Update profile
PUT {{ChefMate.API_HostAddress}}/api/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dietaryPreference": "Vegetarian",
  "cookingSkill": "Intermediate",
  "householdSize": 2,
  "allergies": ["Peanuts"],
  "cuisines": ["Indian", "Italian", "Thai"]
}
